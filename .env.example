# Supabase — copy to `.env` and fill in (Nuxt 4 loads `.env` only, not `.env.local`).
#
# Local development: `pnpm db:start` prints these values (also `pnpm supabase status`).
# Production: project dashboard → Project Settings → API.
#
# The public variables are sent to the browser; never put a secret key in them.

# e.g. http://127.0.0.1:55321 locally, https://<ref>.supabase.co in production
NUXT_PUBLIC_SUPABASE_URL=

# Publishable key (the legacy `anon` key also works)
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by `useSupabaseServiceRole()` in server routes.
# The legacy `service_role` key also works, and must never be exposed client-side.
NUXT_SUPABASE_SECRET_KEY=
