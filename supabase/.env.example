# Local-only secrets for the Supabase CLI. Copy to `supabase/.env` and fill in.
# `config.toml` reads these through `env(...)` substitution. Never commit real values.
#
# In this project the values actually live in the project-root `.env` (git-ignored,
# alongside the `NUXT_*` vars) - the CLI reads that file too. Pick ONE location: an
# empty assignment in `supabase/.env` can shadow the real value, and then GoTrue receives
# the literal string `env(GITHUB_OAUTH_CLIENT_ID)` while still reporting the provider as enabled.
#
# Create the GitHub OAuth app at https://github.com/settings/applications/new
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://127.0.0.1:55321/auth/v1/callback
# (55321 is this project's local API port - see [api].port in supabase/config.toml.)

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
